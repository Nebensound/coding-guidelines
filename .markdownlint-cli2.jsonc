{
  "config": {
    "default": true,
    "MD013": false,
    // Inline HTML is refused: nothing in the repository needs it today. HTML
    // comments are not elements and stay allowed; they carry the long form of
    // a reference in page sources and the markers in the README.
    "MD033": true,
  },
  // Page sources are checked through the pages generated from them, where
  // every reference by identifier is resolved. In a source, such a reference
  // is a link label without a definition.
  "ignores": ["node_modules/**", "pages-src/**"],
}
